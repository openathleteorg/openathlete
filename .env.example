# =============================================================================
# OpenAthlete - Docker Compose configuration
# =============================================================================
# docker compose reads this file as `.env` next to docker-compose.yml.
# scripts/install.sh fills it for you; to do it by hand:
#
#   cp .env.example .env    # then set the two secrets below
#   docker compose up -d
#
# Every API variable is documented in apps/api/.env.example; the ones below
# are those docker-compose.yml passes to the containers.
# =============================================================================

# -----------------------------------------------------------------------------
# Required secrets
# -----------------------------------------------------------------------------

# Signs login sessions. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# Mixed into password hashes. Generate with: openssl rand -hex 32
# Never change it once accounts exist: every existing password would stop
# working. If your instance was started with the former built-in default,
# keep that value: HASH_PEPPER=dev-pepper-change-in-production-min-32-chars
HASH_PEPPER=

# Database password, only used between containers. Instances created before
# October 2026 used openathlete_dev_password: leave it empty to keep it.
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Address
# -----------------------------------------------------------------------------

# Where users open OpenAthlete. The API is served under APP_URL/api, and email
# links and device callback URLs follow it.
APP_URL=http://localhost

# Who can create an account: open (anyone), invite (only with an invitation
# from a coach or athlete) or closed (nobody). The first account is always
# allowed. Choose invite or closed for an instance reachable from the internet.
SIGNUP_MODE=open

# Version of the images: 1 follows every 1.x release; pin one (e.g. 1.1.0)
# to upgrade only when you choose.
OPENATHLETE_VERSION=1

# Port of the web app on this server (default 80). Behind your own reverse
# proxy, or with the https profile below, keep it on localhost:
# WEB_PORT=127.0.0.1:8080

# HTTPS with automatic certificates: point DOMAIN's DNS to this server, set
# APP_URL=https://<DOMAIN> and WEB_PORT=127.0.0.1:8080, then uncomment.
# COMPOSE_PROFILES=https
# DOMAIN=openathlete.example.org

# -----------------------------------------------------------------------------
# Optional features (leave empty to disable)
# -----------------------------------------------------------------------------

# AI: users add their own provider keys in Settings > AI. Keys set here are
# the instance's ("hosted AI"), shared with every user unless AI_HOSTED_ACCESS
# says otherwise. Models are provider/model, e.g. anthropic/claude-sonnet-4-5.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# One model for every AI feature on the instance keys
# (default: openai/gpt-5.6-luna)
AI_MODEL_DEFAULT=
# everyone (default without Stripe), subscribers, or none
AI_HOSTED_ACCESS=
# What each user may spend per month on the instance keys, in US dollars
# (empty: no limit)
AI_HOSTED_MONTHLY_BUDGET_USD=
# Let users add OpenAI-compatible endpoints by URL, such as a local Ollama
# (default: true without Stripe)
AI_ALLOW_CUSTOM_ENDPOINTS=
# Single sign-on through an OpenID Connect provider: register
# <APP_URL>/api/auth/oidc/callback as redirect URI (see the self-hosting guide)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=
# Transactional email, through Brevo or any SMTP server (Brevo wins if both)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
SMTP_HOST=
# Default: 465 with SMTP_SECURE=true (implicit TLS), else 587 with STARTTLS
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Sender address (default: BREVO_FROM_EMAIL, else noreply@openathlete.org)
EMAIL_FROM=
# Receives an email for each new account (empty: none)
SIGNUP_NOTIFICATION_EMAIL=

# Device integrations: see apps/api/.env.example for redirect URIs
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
SUUNTO_CLIENT_ID=
SUUNTO_CLIENT_SECRET=
SUUNTO_SUBSCRIPTION_KEY=
SUUNTO_WEBHOOK_SECRET=

# Background jobs, run by the API container. Import and processing are needed
# for device sync (Strava, Garmin...) to bring activities in.
ENABLE_ACTIVITY_IMPORT=true
ENABLE_ACTIVITY_PROCESSING=true
# Estimates the load of planned sessions with AI (needs an AI key)
ENABLE_TRAINING_LOAD_ESTIMATION=false
