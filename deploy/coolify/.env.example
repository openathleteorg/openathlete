# =============================================================================
# OpenAthlete — Production environment for Coolify / VPS
# =============================================================================
# Copy to .env and fill in values before deploying.
# Used by docker-compose.coolify.yml (repo root) or as reference for Coolify UI.
# =============================================================================

# --- Domains (used in URLs below) ---
APP_DOMAIN=app.openathlete.org
API_DOMAIN=api.openathlete.org
WEBSITE_DOMAIN=openathlete.org

# --- PostgreSQL (Coolify database service or compose) ---
POSTGRES_USER=openathlete
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=openathlete

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- Core API ---
ENV=production
NODE_ENV=production
PORT=3000
APP_URL=https://app.openathlete.org
FRONTEND_URL=https://app.openathlete.org
CORS_ORIGINS=https://openathlete.org,https://www.openathlete.org,https://app.openathlete.org,capacitor://localhost,http://localhost,https://localhost

# Generated after postgres service is up:
# DATABASE_URL=postgresql://openathlete:PASSWORD@postgres:5432/openathlete?schema=public
DATABASE_URL=

# Generated after redis service is up:
# REDIS_URL=redis://:PASSWORD@redis:6379/0
REDIS_URL=

# --- Security (generate with: openssl rand -base64 32) ---
JWT_SECRET_KEY=
HASH_PEPPER=

# --- Email (Brevo, optional) ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@openathlete.org

# --- Strava (optional) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://app.openathlete.org/auth/callback/strava
STRAVA_WEBHOOK_TOKEN=

# --- Polar (optional) ---
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_REDIRECT_URI=https://app.openathlete.org/auth/callback/polar
POLAR_WEBHOOK_URL=https://api.openathlete.org/provider/polar/webhook
POLAR_WEBHOOK_SECRET_KEY=

# --- Garmin (optional) ---
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=https://app.openathlete.org/auth/callback/garmin

# --- Suunto (optional) ---
SUUNTO_CLIENT_ID=
SUUNTO_CLIENT_SECRET=
SUUNTO_REDIRECT_URI=https://app.openathlete.org/auth/callback/suunto
SUUNTO_SUBSCRIPTION_KEY=
SUUNTO_WEBHOOK_SECRET=

# --- Coros (optional) ---
COROS_CLIENT_ID=
COROS_CLIENT_SECRET=
COROS_REDIRECT_URI=https://app.openathlete.org/auth/callback/coros

# --- AI (optional) ---
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# What each Supporter may spend per month on the instance AI keys (USD)
AI_HOSTED_MONTHLY_BUDGET_USD=3

# --- Stripe (optional) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SUPPORTER_MONTHLY=price_xxx
STRIPE_PRICE_SUPPORTER_YEARLY=price_yyy

# --- Firebase (optional, push notifications) ---
FIREBASE_FUNCTIONS_URL=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Monitoring (optional) ---
POSTHOG_PROJECT_TOKEN=

# =============================================================================
# Frontend (Vercel — NOT used by docker-compose, configure in Vercel dashboard)
# See deploy/coolify/MIGRATION.md § "Frontend sur Vercel"
# Reference: apps/web/.env.example
# =============================================================================
# VITE_API_BASE_URL=https://api.openathlete.org
# VITE_WEBSITE_URL=https://openathlete.org
# VITE_WEB_URL=https://app.openathlete.org
# VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
# VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
