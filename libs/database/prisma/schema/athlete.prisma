model Athlete {
  // primary key
  athleteId Int @id @default(autoincrement()) @map("athlete_id")

  // fields

  // relationships
  user                     User                      @relation(fields: [userId], references: [userId])
  userId                   Int                       @unique @map("user_id")
  coachAthletes            CoachAthlete[]
  events                   Event[]
  trainingZones            TrainingZone[]
  records                  Record[]
  equipment                Equipment[]
  cycles                   Cycle[]
  metrics                  AthleteMetric[]
  trainingLoadCalculations TrainingLoadCalculation[]
  trainingPlans            TrainingPlan[]
  availability             AthleteAvailability[]
  providerAccounts         ProviderAccount[]
  providerWorkoutExports   ProviderWorkoutExport[]
  settings                 AthleteSettings?
  injuries                 AthleteInjury[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("athlete")
}

model CoachAthlete {
  // primary key
  coachAthleteId Int @id @default(autoincrement()) @map("coach_athlete_id")

  // fields

  // relationships
  user      User    @relation(fields: [userId], references: [userId])
  userId    Int     @map("user_id")
  athlete   Athlete @relation(fields: [athleteId], references: [athleteId])
  athleteId Int     @map("athlete_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("coach_athlete")
}

model TrainingZoneValue {
  // primary key
  trainingZoneValueId Int @id @default(autoincrement()) @map("training_zone_value_id")

  // fields
  min    Float
  max    Float
  sports SportType[]

  // relationships
  trainingZone   TrainingZone @relation(fields: [trainingZoneId], references: [trainingZoneId])
  trainingZoneId Int          @map("training_zone_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("training_zone_value")
}

model TrainingZone {
  // primary key
  trainingZoneId Int @id @default(autoincrement()) @map("training_zone_id")

  // fields
  name        String
  description String
  index       Int
  type        TrainingZoneType
  color       String

  // relationships
  athlete   Athlete             @relation(fields: [athleteId], references: [athleteId])
  athleteId Int                 @map("athlete_id")
  values    TrainingZoneValue[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("training_zone")
}

model AthleteInvitation {
  // primary key
  athleteInvitationId Int @id @default(autoincrement()) @map("athlete_invitation_id")

  // fields
  email  String
  token  String?           @unique
  status InvitationStatus? // null = auto-accept on account creation, PENDING = user exists and needs to accept

  // relationships
  user   User @relation(fields: [userId], references: [userId])
  userId Int  @map("user_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([token])
  @@index([email])
  @@index([status])
  @@map("athlete_invitation")
}

model CoachInvitation {
  // primary key
  coachInvitationId Int @id @default(autoincrement()) @map("coach_invitation_id")

  // fields
  email  String
  token  String?          @unique // null if user exists, set if user doesn't exist (for account creation)
  status InvitationStatus @default(PENDING)

  // relationships
  athleteUser   User  @relation("CoachInvitationsSent", fields: [athleteUserId], references: [userId])
  athleteUserId Int   @map("athlete_user_id")
  coachUser     User? @relation("CoachInvitationsReceived", fields: [coachUserId], references: [userId])
  coachUserId   Int?  @map("coach_user_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([token])
  @@index([email])
  @@index([status])
  @@index([coachUserId])
  @@map("coach_invitation")
}
