model AthleteSettings {
  // primary key
  athleteSettingsId Int @id @default(autoincrement()) @map("athlete_settings_id")

  // fields
  // Validation requirements for sessions
  requireRpe               Boolean @default(false) @map("require_rpe") // Require RPE to be set for session validation
  requireComment           Boolean @default(false) @map("require_comment") // Require comment/description to be set for session validation
  requireFeedbackQuestions Boolean @default(true) @map("require_feedback_questions") // Enable feedback questions after activity import

  // relationships
  athlete   Athlete @relation(fields: [athleteId], references: [athleteId])
  athleteId Int     @unique @map("athlete_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("athlete_settings")
}
