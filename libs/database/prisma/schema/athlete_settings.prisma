// ============================================================================
// Athlete Settings Models
// ============================================================================
// Athlete-specific settings and preferences for validation and feedback flows.
// ============================================================================

/// Athlete settings.
/// Stores athlete-specific preferences and validation requirements.
/// Controls whether RPE, comments, and feedback questions are required.
model AthleteSettings {
  // primary key
  athleteSettingsId Int @id @default(autoincrement()) @map("athlete_settings_id")

  // fields
  /// Require RPE (Rate of Perceived Exertion) to be set for session validation
  requireRpe               Boolean @default(false) @map("require_rpe")
  /// Require comment/description to be set for session validation
  requireComment           Boolean @default(false) @map("require_comment")
  /// Enable feedback questions after activity import
  requireFeedbackQuestions Boolean @default(true) @map("require_feedback_questions")
  /// Metrics at the top of the metrics page, in the order they were pinned
  pinnedMetrics            MetricType[] @default([HRV_LAST_NIGHT_AVG, HR_REST, SLEEP_DURATION, SLEEP_SCORE, WEIGHT]) @map("pinned_metrics")

  /// Activities with suspect records that the athlete vouched for
  dismissedRecordSuspects  Int[] @default([]) @map("dismissed_record_suspects")

  // relationships
  athlete   Athlete @relation(fields: [athleteId], references: [athleteId])
  athleteId Int     @unique @map("athlete_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("athlete_settings")
}
