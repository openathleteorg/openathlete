model athlete_metric {
  // primary key
  athlete_metric_id Int @id @default(autoincrement())

  // fields
  type  metric_type
  date  DateTime    @db.Date
  value Float
  notes String?

  // relationships
  athlete    athlete @relation(fields: [athlete_id], references: [athlete_id], onDelete: Cascade)
  athlete_id Int

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // indexes
  @@unique([athlete_id, type, date])
  @@index([athlete_id, type])
  @@index([athlete_id, date])
}
