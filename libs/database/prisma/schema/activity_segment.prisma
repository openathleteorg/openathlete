model ActivitySegment {
  // primary key
  activitySegmentId Int @id @default(autoincrement()) @map("activity_segment_id")

  // fields
  segmentType            ActivitySegmentType @map("segment_type")
  name                   String? // optional label (e.g., "Lap 1", "Warmup", "Interval 1")
  orderIndex             Int                 @map("order_index") // position in the activity sequence (0-based)
  startTimeSeconds       Int                 @map("start_time_seconds") // inclusive start time
  endTimeSeconds         Int                 @map("end_time_seconds") // exclusive end time (or inclusive for last segment)
  distance               Float? // in meters
  elevationGain          Float?              @map("elevation_gain") // in meters
  movingTime             Int?                @map("moving_time") // in seconds
  averageSpeed           Float?              @map("average_speed") // in m/s
  maxSpeed               Float?              @map("max_speed") // in m/s
  averageCadence         Float?              @map("average_cadence") // in rpm/spm
  averageWatts           Float?              @map("average_watts") // in watts
  maxWatts               Float?              @map("max_watts") // in watts
  weightedAverageWatts   Float?              @map("weighted_average_watts") // in watts
  averageHeartrate       Float?              @map("average_heartrate") // in bpm
  maxHeartrate           Float?              @map("max_heartrate") // in bpm
  kilojoules             Float? // in kJ
  averageGapSpeed        Float?              @map("average_gap_speed") // in m/s
  averageNormalizedSpeed Float?              @map("average_normalized_speed") // in m/s

  // relationships
  eventActivity   EventActivity @relation(fields: [eventActivityId], references: [eventActivityId], onDelete: Cascade)
  eventActivityId Int           @map("event_activity_id")
  workoutStep     WorkoutStep?  @relation(fields: [workoutStepId], references: [workoutStepId], onDelete: SetNull)
  workoutStepId   Int?          @map("workout_step_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventActivityId, orderIndex])
  @@index([workoutStepId])
  @@map("activity_segment")
}
