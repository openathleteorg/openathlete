model activity_segment {
  // primary key
  activity_segment_id Int @id @default(autoincrement())

  // fields
  segment_type             activity_segment_type
  name                     String? // optional label (e.g., "Lap 1", "Warmup", "Interval 1")
  order_index              Int // position in the activity sequence (0-based)
  start_time_seconds       Int // inclusive start time
  end_time_seconds         Int // exclusive end time (or inclusive for last segment)
  distance                 Float? // in meters
  elevation_gain           Float? // in meters
  moving_time              Int? // in seconds
  average_speed            Float? // in m/s
  max_speed                Float? // in m/s
  average_cadence          Float? // in rpm/spm
  average_watts            Float? // in watts
  max_watts                Float? // in watts
  weighted_average_watts   Float? // in watts
  average_heartrate        Float? // in bpm
  max_heartrate            Float? // in bpm
  kilojoules               Float? // in kJ
  average_gap_speed        Float? // in m/s
  average_normalized_speed Float? // in m/s

  // relationships
  event_activity    event_activity @relation(fields: [event_activity_id], references: [event_activity_id], onDelete: Cascade)
  event_activity_id Int
  workout_step      workout_step?  @relation(fields: [workout_step_id], references: [workout_step_id], onDelete: SetNull)
  workout_step_id   Int?

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([event_activity_id, order_index])
  @@index([workout_step_id])
}
