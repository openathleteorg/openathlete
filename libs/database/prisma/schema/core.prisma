model user {
  // primary key
  user_id Int @id @default(autoincrement())

  // fields
  email      String      @unique
  password   String
  roles      user_role[]
  first_name String
  last_name  String
  gender     gender?

  // relationships
  athlete                     athlete?
  coach_athletes              coach_athlete[]
  tokens                      token[]
  templates                   event_template[]
  agent_threads               agent_thread[]
  event_template_folder       event_template_folder[]
  athlete_invitations         athlete_invitation[]
  coach_invitations_sent      coach_invitation[] @relation("CoachInvitationsSent")
  coach_invitations_received  coach_invitation[] @relation("CoachInvitationsReceived")
  message_thread_participants message_thread_participant[]
  sent_messages               message[]
  message_read_receipts       message_read_receipt[]

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model provider_account {
  // primary key
  provider_account_id Int @id @default(autoincrement())

  // fields
  provider         connector_provider
  access_token     String
  refresh_token    String?
  expires_at       DateTime?
  scopes           String?
  status           provider_account_status @default(active)
  external_user_id String?

  // relationships
  athlete    athlete @relation(fields: [athlete_id], references: [athlete_id])
  athlete_id Int

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([athlete_id, provider])
  @@index([external_user_id])
}

model provider_workout_export {
  // primary key
  provider_workout_export_id Int @id @default(autoincrement())

  // fields
  athlete_id    Int
  provider      connector_provider
  workout_id    Int
  planned_date  DateTime // store as date-only; convention: midnight UTC
  external_id   String?
  status        provider_workout_export_status @default(pending)
  last_sync_at  DateTime?
  attempt_count Int                            @default(0)
  content_hash  String
  error_code    String?
  error_message String?
  raw_payload   Json?

  // relationships
  athlete athlete @relation(fields: [athlete_id], references: [athlete_id])
  workout workout @relation(fields: [workout_id], references: [workout_id])

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([athlete_id, provider, workout_id, planned_date])
  @@index([status, planned_date])
}

model token {
  // primary key
  token_id Int @id @default(autoincrement())

  // fields
  token String     @unique
  type  token_type

  // relationships
  user    user @relation(fields: [user_id], references: [user_id])
  user_id Int

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
