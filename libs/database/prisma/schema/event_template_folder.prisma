model EventTemplateFolder {

  // primary key
  eventTemplateFolderId Int @id @default(autoincrement()) @map("event_template_folder_id")

  // fields
  name        String
  color       String? @default("#6366f1")
  description String  @default("")

  // relationships
  user           User                  @relation(fields: [userId], references: [userId])
  userId         Int                   @map("user_id")
  parentFolder   EventTemplateFolder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [eventTemplateFolderId])
  parentFolderId Int?                  @map("parent_folder_id")
  childFolders   EventTemplateFolder[] @relation("FolderHierarchy")
  eventTemplates EventTemplate[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([parentFolderId])
  @@map("event_template_folder")
}
