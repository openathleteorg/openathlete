// ============================================================================
// Subscription Models
// ============================================================================
// User subscription management, billed through Stripe (web) or the App Store
// (iOS app).
// ============================================================================

/// User subscription.
/// Manages user subscription plans, billed via Stripe or App Store in-app purchases.
/// Tracks subscription status, billing periods, and trial information.
model Subscription {
  // primary key
  subscriptionId Int @id @default(autoincrement()) @map("subscription_id")

  // fields
  /// Subscription plan: FREE or SUPPORTER
  plan                 SubscriptionPlan
  /// Billing interval of a Supporter subscription
  billingInterval      BillingInterval?   @map("billing_interval")
  /// Subscription status: active, canceled, past_due, trialing, incomplete, incomplete_expired, or unpaid
  status               SubscriptionStatus @default(active)
  /// Stripe customer ID
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  /// Stripe subscription ID
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  /// Current billing period start date
  currentPeriodStart   DateTime?          @map("current_period_start")
  /// Current billing period end date
  currentPeriodEnd     DateTime?          @map("current_period_end")
  /// Trial end date (if applicable)
  trialEnd             DateTime?          @map("trial_end")
  /// Whether subscription is set to cancel at period end
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  /// Store that bills the Supporter subscription; null on the free plan
  provider                   BillingProvider?
  /// App Store originalTransactionId, shared by every renewal of the subscription
  appleOriginalTransactionId String?          @unique @map("apple_original_transaction_id")
  /// UUID the iOS app passes to StoreKit as appAccountToken, tying purchases to this user
  appleAppAccountToken       String?          @unique @map("apple_app_account_token") @db.Uuid

  // relationships
  user   User @relation(fields: [userId], references: [userId])
  userId Int  @unique @map("user_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@map("subscription")
}
