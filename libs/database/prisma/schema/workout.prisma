model workout {
  // primary key
  workout_id Int @id @default(autoincrement())

  // relationships
  event_training           event_training            @relation(fields: [event_training_id], references: [event_training_id], onDelete: Cascade)
  event_training_id        Int                       @unique
  steps                    workout_step[]
  provider_workout_exports provider_workout_export[]

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model workout_step {
  // primary key
  workout_step_id Int @id @default(autoincrement())

  // fields
  order_index     Int // position in the workout sequence
  step_type       workout_step_type
  name            String? // optional label (e.g., "Warmup", "Tempo intervals")
  notes           String?               @default("") // additional instructions/comments
  duration_type   workout_duration_type
  duration_value  Float? // value depends on duration_type
  duration_target Float? // optional target for LAP_BUTTON type

  // relationships
  workout           workout?              @relation(fields: [workout_id], references: [workout_id], onDelete: Cascade)
  workout_id        Int?
  repeat_parent     workout_repeat?       @relation("ParentRepeat", fields: [repeat_parent_id], references: [workout_repeat_id], onDelete: Cascade)
  repeat_parent_id  Int?
  repeat_block      workout_repeat?       @relation("RepeatBlock")
  targets           workout_step_target[]
  activity_segments activity_segment[]

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([workout_id, order_index])
}

model workout_repeat {
  // primary key
  workout_repeat_id Int @id @default(autoincrement())

  // fields
  repetitions Int // number of times to repeat

  // relationships
  step        workout_step   @relation("RepeatBlock", fields: [step_id], references: [workout_step_id], onDelete: Cascade)
  step_id     Int            @unique
  child_steps workout_step[] @relation("ParentRepeat")

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model workout_step_target {
  // primary key
  workout_step_target_id Int @id @default(autoincrement())

  // fields
  target_type  workout_target_type
  target_min   Float? // minimum value for range targets
  target_max   Float? // maximum value for range targets
  target_value Float? // single value target (for ZONE, this is the zone number 1-5)
  metric_type  metric_type?

  // relationships
  step    workout_step @relation(fields: [step_id], references: [workout_step_id], onDelete: Cascade)
  step_id Int

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([step_id])
}
