// ============================================================================
// Workout Models
// ============================================================================
// Structured workout definitions with steps, targets, and repeat blocks.
// Workouts define detailed training sessions with warmup, intervals, cooldown,
// and can be exported to external providers (Garmin, etc.).
// ============================================================================

/// Structured workout definition.
/// Represents a detailed workout plan with steps, targets, and duration.
/// Linked to an EventTraining and can be exported to external providers.
model Workout {
  // primary key
  workoutId Int @id @default(autoincrement()) @map("workout_id")

  // relationships
  eventTraining          EventTraining           @relation(fields: [eventTrainingId], references: [eventTrainingId], onDelete: Cascade)
  eventTrainingId        Int                     @unique @map("event_training_id")
  steps                  WorkoutStep[]
  providerWorkoutExports ProviderWorkoutExport[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workout")
}

/// Workout step.
/// Represents a single step in a workout (e.g., warmup, interval, cooldown).
/// Steps can have duration (time, distance, calories, etc.) and targets
/// (pace, heart rate, power, etc.). Steps can be nested in repeat blocks.
model WorkoutStep {
  // primary key
  workoutStepId Int @id @default(autoincrement()) @map("workout_step_id")

  // fields
  /// Position in the workout sequence (0-based)
  orderIndex     Int                 @map("order_index")
  /// Step type: WARMUP, COOLDOWN, INTERVAL_ACTIVE, INTERVAL_REST, STEADY, REPEAT, or FREE
  stepType       WorkoutStepType     @map("step_type")
  /// Optional label (e.g., "Warmup", "Tempo intervals")
  name           String?
  /// Additional instructions/comments
  notes          String?             @default("")
  /// Duration type: TIME, DISTANCE, CALORIES, HR_BELOW, HR_ABOVE, LAP_BUTTON, OPEN, or REPS
  durationType   WorkoutDurationType @map("duration_type")
  /// Duration value (depends on duration_type: seconds, meters, calories, etc.)
  durationValue  Float?              @map("duration_value")
  /// Optional target for LAP_BUTTON type
  durationTarget Float?              @map("duration_target")
  /// Strength exercise the step performs: "c:<slug>" from the bundled
  /// catalog, "u:<id>" a custom exercise. `name` keeps its name for readers
  /// that do not resolve it (device exports, AI, older apps)
  exerciseRef    String?             @map("exercise_ref")
  /// Lifting tempo, eccentric-pause-concentric-pause in seconds ("3-1-1-0")
  tempo          String?
  /// Which side works: each side in turn, one side or alternating
  side           ExerciseSide?

  // relationships
  workout          Workout?            @relation(fields: [workoutId], references: [workoutId], onDelete: Cascade)
  workoutId        Int?                @map("workout_id")
  repeatParent     WorkoutRepeat?      @relation("ParentRepeat", fields: [repeatParentId], references: [workoutRepeatId], onDelete: Cascade)
  repeatParentId   Int?                @map("repeat_parent_id")
  repeatBlock      WorkoutRepeat?      @relation("RepeatBlock")
  targets          WorkoutStepTarget[]
  activitySegments ActivitySegment[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workoutId, orderIndex])
  @@index([repeatParentId])
  @@map("workout_step")
}

/// Workout repeat block.
/// Defines a group of steps to be repeated multiple times. The repeat block
/// contains child steps that are executed in sequence, then repeated.
model WorkoutRepeat {
  // primary key
  workoutRepeatId Int @id @default(autoincrement()) @map("workout_repeat_id")

  // fields
  /// Number of times to repeat the child steps
  repetitions     Int
  /// How the athlete runs the block: plain sets, a superset or circuit
  /// (exercises in a row, then rest), every minute on the minute, as many
  /// rounds as possible, or Tabata
  kind            WorkoutRepeatKind @default(REPEAT)
  /// EMOM: a round starts every this many seconds
  intervalSeconds Int?              @map("interval_seconds")
  /// AMRAP: the time the rounds fit in
  timeCapSeconds  Int?              @map("time_cap_seconds")

  // relationships
  step       WorkoutStep   @relation("RepeatBlock", fields: [stepId], references: [workoutStepId], onDelete: Cascade)
  stepId     Int           @unique @map("step_id")
  childSteps WorkoutStep[] @relation("ParentRepeat")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workout_repeat")
}

/// Workout step target.
/// Defines performance targets for a workout step (pace, heart rate, power, etc.).
/// A step can have multiple targets (e.g., both pace and heart rate zones).
model WorkoutStepTarget {
  // primary key
  workoutStepTargetId Int @id @default(autoincrement()) @map("workout_step_target_id")

  // fields
  /// Target type: OPEN, PACE, HEARTRATE, POWER, CADENCE, RPE, WEIGHT, or ZONE
  targetType  WorkoutTargetType @map("target_type")
  /// Minimum value for range targets
  targetMin   Float?            @map("target_min")
  /// Maximum value for range targets
  targetMax   Float?            @map("target_max")
  /// Single value target (for ZONE type, this is the zone number 1-5)
  targetValue Float?            @map("target_value")
  /// Metric type for context (optional)
  metricType  MetricType?       @map("metric_type")

  // relationships
  step   WorkoutStep @relation(fields: [stepId], references: [workoutStepId], onDelete: Cascade)
  stepId Int         @map("step_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([stepId])
  @@map("workout_step_target")
}

/// Strength exercise a coach or athlete created, beside the bundled catalog.
/// Workout steps point to it as "u:<customExerciseId>".
model CustomExercise {
  // primary key
  customExerciseId Int @id @default(autoincrement()) @map("custom_exercise_id")

  // fields
  name                 String
  /// How to perform it, shown to the athlete
  instructions         String              @default("")
  /// A video or image link the athlete can open
  mediaUrl             String?             @map("media_url")
  /// Catalog vocabulary: "chest", "upper legs"...
  bodyPart             String?             @map("body_part")
  /// Catalog vocabulary: "dumbbell", "body weight"...
  equipment            String?
  /// Reps or a hold, and the defaults a new set starts from
  defaultDurationType  WorkoutDurationType @default(REPS) @map("default_duration_type")
  defaultDurationValue Float?              @map("default_duration_value")

  // relationships
  user   User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId Int  @map("user_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("custom_exercise")
}
