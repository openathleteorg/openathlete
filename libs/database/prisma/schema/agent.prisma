model AgentThread {
  // primary key
  threadId Int @id @default(autoincrement()) @map("thread_id")

  // fields
  title    String?
  metadata Json?

  // relationships
  user     User           @relation(fields: [userId], references: [userId])
  userId   Int            @map("user_id")
  messages AgentMessage[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("agent_thread")
}

model AgentMessage {
  // primary key
  messageId Int @id @default(autoincrement()) @map("message_id")

  // fields
  role     AgentMessageRole
  metadata Json?
  status   AgentMessageStatus @default(pending)

  // relationships
  thread          AgentThread         @relation(fields: [threadId], references: [threadId], onDelete: Cascade)
  threadId        Int                 @map("thread_id")
  parentMessage   AgentMessage?       @relation("MessageThread", fields: [parentMessageId], references: [messageId])
  parentMessageId Int?                @map("parent_message_id")
  childMessages   AgentMessage[]      @relation("MessageThread")
  blocks          AgentMessageBlock[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("agent_message")
}

model AgentMessageBlock {
  // primary key
  blockId Int @id @default(autoincrement()) @map("block_id")

  // fields
  type     AgentBlockType
  order    Int
  content  String
  metadata Json?
  status   AgentBlockStatus @default(completed)
  error    String?

  toolName   String? @map("tool_name")
  toolInput  Json?   @map("tool_input")
  toolOutput Json?   @map("tool_output")

  chartType String? @map("chart_type")
  chartData Json?   @map("chart_data")

  // relationships
  message   AgentMessage @relation(fields: [messageId], references: [messageId], onDelete: Cascade)
  messageId Int          @map("message_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([messageId, order])
  @@map("agent_message_block")
}
