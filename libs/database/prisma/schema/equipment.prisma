model Equipment {

  // primary key
  equipmentId Int @id @default(autoincrement()) @map("equipment_id")

  // fields
  name          String
  type          EquipmentType
  totalDistance Float         @default(0) @map("total_distance") // in meters
  isDefault     Boolean       @default(false) @map("is_default")
  sports        SportType[]

  // relationships
  athlete    Athlete         @relation(fields: [athleteId], references: [athleteId])
  athleteId  Int             @map("athlete_id")
  activities EventActivity[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("equipment")
}
