model TrainingPlan {
  // primary key
  trainingPlanId Int @id @default(autoincrement()) @map("training_plan_id")

  // fields
  name        String
  description String?
  goal        String // ex: "Finish UTMB 2025", "Sub-3:30 marathon"
  startDate   DateTime   @map("start_date")
  endDate     DateTime   @map("end_date")
  status      PlanStatus @default(DRAFT)

  // relationships
  athlete   Athlete @relation(fields: [athleteId], references: [athleteId], onDelete: Cascade)
  athleteId Int     @map("athlete_id")
  cycles    Cycle[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([athleteId, status])
  @@map("training_plan")
}

model TrainingWeek {
  // primary key
  trainingWeekId Int @id @default(autoincrement()) @map("training_week_id")

  // fields
  weekNumber   Int      @map("week_number") // position in the cycle (1, 2, 3, ...)
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  theme        String? // ex: "VO2 intervals", "Base building", "Taper week"
  targetVolume Int?     @map("target_volume") // target volume in seconds
  targetLoad   Float?   @map("target_load") // target training load (TRIMP)

  // relationships
  cycle    Cycle   @relation(fields: [cycleId], references: [cycleId], onDelete: Cascade)
  cycleId  Int     @map("cycle_id")
  sessions Event[] // training sessions scheduled in this week

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([cycleId, weekNumber])
  @@map("training_week")
}

model AthleteAvailability {
  // primary key
  athleteAvailabilityId Int @id @default(autoincrement()) @map("athlete_availability_id")

  // fields
  dayOfWeek Int                  @map("day_of_week") // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime String               @map("start_time") // format "HH:mm" (24h format), ex: "08:00"
  endTime   String               @map("end_time") // format "HH:mm" (24h format), ex: "12:00"
  priority  AvailabilityPriority @default(MEDIUM)

  // relationships
  athlete   Athlete @relation(fields: [athleteId], references: [athleteId], onDelete: Cascade)
  athleteId Int     @map("athlete_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([athleteId, dayOfWeek])
  @@map("athlete_availability")
}
