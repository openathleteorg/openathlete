// ============================================================================
// Training Plan Models
// ============================================================================
// Training plan architecture for periodized training:
// - TrainingPlan: High-level plan with goal and date range
// - Cycle: Training cycles within a plan (e.g., Base, Build, Taper)
// - TrainingWeek: Weekly structure within cycles
// - AthleteAvailability: Athlete's weekly schedule for plan generation
// ============================================================================

/// Training plan.
/// High-level training plan with a goal (e.g., "Finish UTMB 2025", "Sub-3:30 marathon").
/// Contains multiple cycles and can be in DRAFT, ACTIVE, COMPLETED, or ARCHIVED status.
model TrainingPlan {
  // primary key
  trainingPlanId Int @id @default(autoincrement()) @map("training_plan_id")

  // fields
  /// Plan name
  name        String
  /// Plan description
  description String?
  /// Training goal (e.g., "Finish UTMB 2025", "Sub-3:30 marathon")
  goal        String
  /// Plan start date
  startDate   DateTime   @map("start_date")
  /// Plan end date
  endDate     DateTime   @map("end_date")
  /// Plan status: DRAFT, ACTIVE, COMPLETED, or ARCHIVED
  status      PlanStatus @default(DRAFT)
  /// Applied from the library: the date the user chose fixed the start or
  /// the end (race day). Null for plans imported before the library
  anchor       PlanAnchor?
  /// Day plan weeks start on (0 = Sunday … 6 = Saturday)
  weekStartsOn Int         @default(1) @map("week_starts_on")

  // relationships
  athlete    Athlete               @relation(fields: [athleteId], references: [athleteId], onDelete: Cascade)
  athleteId  Int                   @map("athlete_id")
  /// The library plan it was applied from, if it still exists
  template   TrainingPlanTemplate? @relation(fields: [templateId], references: [trainingPlanTemplateId], onDelete: SetNull)
  templateId Int?                  @map("template_id")
  cycles     Cycle[]
  sessions   Event[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([athleteId, status])
  @@index([templateId])
  @@map("training_plan")
}

/// Training plan in a user's library.
/// Not tied to dates: its content is laid out by week number and weekday
/// (the format of the website plans, `seoPlanDataSchema` in libs/shared), with
/// targets relative to zones, so it fits whoever it is applied to.
model TrainingPlanTemplate {
  // primary key
  trainingPlanTemplateId Int @id @default(autoincrement()) @map("training_plan_template_id")

  // fields
  name        String
  description String     @default("")
  goal        String     @default("")
  /// Main sport, for the library filters
  sport       SportType?
  level       PlanLevel?
  /// Length in weeks, kept in step with the content
  weeks       Int
  /// Cycles → weeks → sessions, validated by `trainingPlanContentSchema`
  content     Json

  // relationships
  user     User                 @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId   Int                  @map("user_id")
  folder   EventTemplateFolder? @relation(fields: [folderId], references: [eventTemplateFolderId], onDelete: SetNull)
  folderId Int?                 @map("folder_id")
  applied  TrainingPlan[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([folderId])
  @@map("training_plan_template")
}

/// Training week.
/// Represents a week within a training cycle. Contains training sessions
/// (Events) and can have a theme, target volume, and target training load.
model TrainingWeek {
  // primary key
  trainingWeekId Int @id @default(autoincrement()) @map("training_week_id")

  // fields
  /// Position in the cycle (1, 2, 3, ...)
  weekNumber   Int      @map("week_number")
  /// Week start date
  startDate    DateTime @map("start_date")
  /// Week end date
  endDate      DateTime @map("end_date")
  /// Week theme (e.g., "VO2 intervals", "Base building", "Taper week")
  theme        String?
  /// Target training volume in seconds
  targetVolume Int?     @map("target_volume")
  /// Target training load (TRIMP)
  targetLoad   Float?   @map("target_load")

  // relationships
  cycle    Cycle   @relation(fields: [cycleId], references: [cycleId], onDelete: Cascade)
  cycleId  Int     @map("cycle_id")
  sessions Event[] // training sessions scheduled in this week

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([cycleId, weekNumber])
  @@map("training_week")
}

/// Athlete availability schedule.
/// Defines when an athlete is available for training during the week.
/// Used by training plan generation to schedule sessions at appropriate times.
model AthleteAvailability {
  // primary key
  athleteAvailabilityId Int @id @default(autoincrement()) @map("athlete_availability_id")

  // fields
  /// Day of week: 0=Sunday, 1=Monday, ..., 6=Saturday
  dayOfWeek Int                  @map("day_of_week")
  /// Start time in "HH:mm" format (24h), e.g., "08:00"
  startTime String               @map("start_time")
  /// End time in "HH:mm" format (24h), e.g., "12:00"
  endTime   String               @map("end_time")
  /// Availability priority: LOW, MEDIUM, or HIGH
  priority  AvailabilityPriority @default(MEDIUM)

  // relationships
  athlete   Athlete @relation(fields: [athleteId], references: [athleteId], onDelete: Cascade)
  athleteId Int     @map("athlete_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([athleteId, dayOfWeek])
  @@map("athlete_availability")
}
