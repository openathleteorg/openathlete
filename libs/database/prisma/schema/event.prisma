model event {
  // primary key
  event_id Int @id @default(autoincrement())

  // fields
  start_date DateTime
  end_date   DateTime
  name       String
  type       event_type

  // relationships
  training         event_training?
  competition      event_competition?
  note             event_note?
  activity         event_activity?
  athlete          athlete?           @relation(fields: [athlete_id], references: [athlete_id])
  athlete_id       Int?
  templates        event_template[]
  training_week    training_week?     @relation(fields: [training_week_id], references: [training_week_id])
  training_week_id Int?

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([training_week_id])
}

model event_training {
  // primary key
  event_training_id Int @id @default(autoincrement())

  // fields
  sport               sport_type
  description         String     @default("")
  goal_distance       Float? // in meters
  goal_elevation_gain Float? // in meters
  goal_duration       Int? // in seconds
  goal_rpe            Float? // in RPE (0-1)

  // relationships
  event                            event           @relation(fields: [event_id], references: [event_id])
  event_id                         Int             @unique
  related_activity                 event_activity? @relation(fields: [related_activity_id], references: [event_activity_id])
  related_activity_id              Int?            @unique
  workout                          workout? // structured workout definition
  message_thread                   message_thread? @relation("TrainingCommentThread", fields: [message_thread_message_thread_id], references: [message_thread_id])
  message_thread_message_thread_id Int?            @unique
}

model event_competition {
  // primary key
  event_competition_id Int @id @default(autoincrement())

  // fields
  sport               sport_type
  description         String     @default("")
  goal_distance       Float? // in meters
  goal_elevation_gain Float? // in meters
  goal_duration       Int? // in seconds
  goal_rpe            Float? // in RPE (0-1)

  // relationships
  event               event           @relation(fields: [event_id], references: [event_id])
  event_id            Int             @unique
  related_activity    event_activity? @relation(fields: [related_activity_id], references: [event_activity_id])
  related_activity_id Int?            @unique
}

model event_note {
  // primary key
  event_note_id Int @id @default(autoincrement())

  // fields
  description String @default("")

  // relationships
  event    event @relation(fields: [event_id], references: [event_id])
  event_id Int   @unique
}

model event_activity {
  // primary key
  event_activity_id Int @id @default(autoincrement())

  // fields
  provider                 connector_provider?
  distance                 Float // in meters
  elevation_gain           Float // in meters
  moving_time              Int // in seconds
  average_speed            Float // in m/s
  max_speed                Float // in m/s
  average_cadence          Float? // in rpm
  average_watts            Float? // in watts
  max_watts                Float? // in watts
  weighted_average_watts   Float? // in watts
  average_heartrate        Float? // in bpm
  max_heartrate            Float? // in bpm
  kilojoules               Float? // in kJ
  rpe                      Float? // in RPE (0-1)
  external_id              String
  sport                    sport_type
  stream                   Json?
  description              String              @default("")
  average_gap_speed        Float? // in m/s
  average_normalized_speed Float? // in m/s

  // relationships
  event                 event                         @relation(fields: [event_id], references: [event_id])
  event_id              Int                           @unique
  related_training      event_training?
  related_competition   event_competition?
  records               record[]
  equipment             equipment?                    @relation(fields: [equipment_id], references: [equipment_id])
  equipment_id          Int?
  weather               event_activity_weather?
  normalization         event_activity_normalization?
  training_load_entries training_load_entry[]
  message_thread        message_thread?               @relation("ActivityCommentThread") // comment thread for this activity

  @@unique([external_id]) // Index for fast lookup by external provider ID
}

model event_activity_weather {
  // primary key
  event_activity_weather_id Int @id @default(autoincrement())

  // fields
  resolution_m Int     @default(500)
  provider     String?
  samples      Json // JSON array of samples with per-distance weather

  // relationships
  event_activity    event_activity @relation(fields: [event_activity_id], references: [event_activity_id])
  event_activity_id Int            @unique

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model event_activity_normalization {
  // primary key
  event_activity_normalization_id Int @id @default(autoincrement())

  // fields
  average_normalized_speed Float? // in m/s, duplicate for quick access; also stored on event_activity

  // relationships
  event_activity    event_activity                        @relation(fields: [event_activity_id], references: [event_activity_id])
  event_activity_id Int                                   @unique
  factors           event_activity_normalization_factor[]

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model event_activity_normalization_factor {
  // primary key
  event_activity_normalization_factor_id Int @id @default(autoincrement())

  // fields
  factor       normalization_factor
  // Signed contribution to time vs flat/no-condition baseline over activity
  // Store both absolute seconds and fraction for flexible analytics
  time_seconds Float // >0 cost, <0 benefit
  percent      Float // fraction of baseline moving time [0,1]

  // relationships
  normalization                   event_activity_normalization @relation(fields: [event_activity_normalization_id], references: [event_activity_normalization_id])
  event_activity_normalization_id Int

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model event_template {
  // primary key
  event_template_id Int @id @default(autoincrement())

  // fields

  // relationships
  event     event                  @relation(fields: [event_id], references: [event_id])
  event_id  Int                    @unique
  user      user                   @relation(fields: [user_id], references: [user_id])
  user_id   Int
  folder    event_template_folder? @relation(fields: [folder_id], references: [event_template_folder_id])
  folder_id Int?

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([folder_id])
}

model cycle {
  // primary key
  cycle_id Int @id @default(autoincrement())

  // fields
  name        String
  description String       @default("")
  start_date  DateTime
  end_date    DateTime
  color       String? // hex color code (e.g., "#FF5733")
  phase       cycle_phase? // training phase type (BASE, SPECIFIC, TAPER, etc.)

  // relationships
  athlete          athlete?        @relation(fields: [athlete_id], references: [athlete_id])
  athlete_id       Int?
  training_plan    training_plan?  @relation(fields: [training_plan_id], references: [training_plan_id])
  training_plan_id Int?
  weeks            training_week[]

  // timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([training_plan_id])
}
