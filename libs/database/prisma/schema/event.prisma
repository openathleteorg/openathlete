model Event {

  // primary key
  eventId Int @id @default(autoincrement()) @map("event_id")

  // fields
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  name      String
  type      EventType

  // relationships
  training       EventTraining?
  competition    EventCompetition?
  note           EventNote?
  activity       EventActivity?
  athlete        Athlete?          @relation(fields: [athleteId], references: [athleteId])
  athleteId      Int?              @map("athlete_id")
  templates      EventTemplate[]
  trainingWeek   TrainingWeek?     @relation(fields: [trainingWeekId], references: [trainingWeekId])
  trainingWeekId Int?              @map("training_week_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([trainingWeekId])
  @@map("event")
}

model EventTraining {

  // primary key
  eventTrainingId Int @id @default(autoincrement()) @map("event_training_id")

  // fields
  sport             SportType
  description       String    @default("")
  goalDistance      Float?    @map("goal_distance") // in meters
  goalElevationGain Float?    @map("goal_elevation_gain") // in meters
  goalDuration      Int?      @map("goal_duration") // in seconds
  goalRpe           Float?    @map("goal_rpe") // in RPE (0-1)
  estimatedLoad     Float?    @map("estimated_load") // estimated TRIMP load for this training session

  // relationships
  event             Event          @relation(fields: [eventId], references: [eventId])
  eventId           Int            @unique @map("event_id")
  relatedActivity   EventActivity? @relation(fields: [relatedActivityId], references: [eventActivityId])
  relatedActivityId Int?           @unique @map("related_activity_id")
  workout           Workout? // structured workout definition
  messageThread     MessageThread? @relation("TrainingCommentThread", fields: [messageThreadId], references: [messageThreadId])
  messageThreadId   Int?           @unique @map("message_thread_message_thread_id")

  @@map("event_training")
}

model EventCompetition {

  // primary key
  eventCompetitionId Int @id @default(autoincrement()) @map("event_competition_id")

  // fields
  sport             SportType
  description       String    @default("")
  goalDistance      Float?    @map("goal_distance") // in meters
  goalElevationGain Float?    @map("goal_elevation_gain") // in meters
  goalDuration      Int?      @map("goal_duration") // in seconds
  goalRpe           Float?    @map("goal_rpe") // in RPE (0-1)

  // relationships
  event             Event          @relation(fields: [eventId], references: [eventId])
  eventId           Int            @unique @map("event_id")
  relatedActivity   EventActivity? @relation(fields: [relatedActivityId], references: [eventActivityId])
  relatedActivityId Int?           @unique @map("related_activity_id")

  @@map("event_competition")
}

model EventNote {

  // primary key
  eventNoteId Int @id @default(autoincrement()) @map("event_note_id")

  // fields
  description String @default("")

  // relationships
  event   Event @relation(fields: [eventId], references: [eventId])
  eventId Int   @unique @map("event_id")

  @@map("event_note")
}

model EventActivity {

  // primary key
  eventActivityId Int @id @default(autoincrement()) @map("event_activity_id")

  // fields
  provider               ConnectorProvider?
  distance               Float // in meters
  elevationGain          Float              @map("elevation_gain") // in meters
  movingTime             Int                @map("moving_time") // in seconds
  averageSpeed           Float              @map("average_speed") // in m/s
  maxSpeed               Float              @map("max_speed") // in m/s
  averageCadence         Float?             @map("average_cadence") // in rpm
  averageWatts           Float?             @map("average_watts") // in watts
  maxWatts               Float?             @map("max_watts") // in watts
  weightedAverageWatts   Float?             @map("weighted_average_watts") // in watts
  averageHeartrate       Float?             @map("average_heartrate") // in bpm
  maxHeartrate           Float?             @map("max_heartrate") // in bpm
  kilojoules             Float? // in kJ
  rpe                    Float? // in RPE (0-1)
  externalId             String             @map("external_id")
  sport                  SportType
  stream                 Json?
  description            String             @default("")
  averageGapSpeed        Float?             @map("average_gap_speed") // in m/s
  averageNormalizedSpeed Float?             @map("average_normalized_speed") // in m/s
  feedbackSkipped        Boolean            @default(false) @map("feedback_skipped") // true if user skipped the feedback flow

  // relationships
  event               Event                       @relation(fields: [eventId], references: [eventId])
  eventId             Int                         @unique @map("event_id")
  relatedTraining     EventTraining?
  relatedCompetition  EventCompetition?
  records             Record[]
  equipment           Equipment?                  @relation(fields: [equipmentId], references: [equipmentId])
  equipmentId         Int?                        @map("equipment_id")
  weather             EventActivityWeather?
  normalization       EventActivityNormalization?
  trainingLoadEntries TrainingLoadEntry[]
  messageThread       MessageThread?              @relation("ActivityCommentThread") // comment thread for this activity
  segments            ActivitySegment[]
  feedbackQuestions   ActivityFeedbackQuestion[]
  extractedInjuries   AthleteInjury[] // injuries extracted from feedback
  feedbackEmbedding   ActivityFeedbackEmbedding? // vector embedding of feedback responses

  @@unique([externalId]) // Index for fast lookup by external provider ID
  @@map("event_activity")
}

model EventActivityWeather {

  // primary key
  eventActivityWeatherId Int @id @default(autoincrement()) @map("event_activity_weather_id")

  // fields
  resolutionM Int     @default(500) @map("resolution_m")
  provider    String?
  samples     Json // JSON array of samples with per-distance weather

  // relationships
  eventActivity   EventActivity @relation(fields: [eventActivityId], references: [eventActivityId])
  eventActivityId Int           @unique @map("event_activity_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("event_activity_weather")
}

model EventActivityNormalization {

  // primary key
  eventActivityNormalizationId Int @id @default(autoincrement()) @map("event_activity_normalization_id")

  // fields
  averageNormalizedSpeed Float? @map("average_normalized_speed") // in m/s, duplicate for quick access; also stored on event_activity

  // relationships
  eventActivity   EventActivity                      @relation(fields: [eventActivityId], references: [eventActivityId])
  eventActivityId Int                                @unique @map("event_activity_id")
  factors         EventActivityNormalizationFactor[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("event_activity_normalization")
}

model EventActivityNormalizationFactor {

  // primary key
  eventActivityNormalizationFactorId Int @id @default(autoincrement()) @map("event_activity_normalization_factor_id")

  // fields
  factor      NormalizationFactor
  // Signed contribution to time vs flat/no-condition baseline over activity
  // Store both absolute seconds and fraction for flexible analytics
  timeSeconds Float               @map("time_seconds") // >0 cost, <0 benefit
  percent     Float // fraction of baseline moving time [0,1]

  // relationships
  normalization                EventActivityNormalization @relation(fields: [eventActivityNormalizationId], references: [eventActivityNormalizationId])
  eventActivityNormalizationId Int                        @map("event_activity_normalization_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("event_activity_normalization_factor")
}

model EventTemplate {

  // primary key
  eventTemplateId Int @id @default(autoincrement()) @map("event_template_id")

  // fields

  // relationships
  event    Event                @relation(fields: [eventId], references: [eventId])
  eventId  Int                  @unique @map("event_id")
  user     User                 @relation(fields: [userId], references: [userId])
  userId   Int                  @map("user_id")
  folder   EventTemplateFolder? @relation(fields: [folderId], references: [eventTemplateFolderId])
  folderId Int?                 @map("folder_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([folderId])
  @@map("event_template")
}

model Cycle {

  // primary key
  cycleId Int @id @default(autoincrement()) @map("cycle_id")

  // fields
  name        String
  description String      @default("")
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  color       String? // hex color code (e.g., "#FF5733")
  phase       CyclePhase? // training phase type (BASE, SPECIFIC, TAPER, etc.)

  // relationships
  athlete        Athlete?       @relation(fields: [athleteId], references: [athleteId])
  athleteId      Int?           @map("athlete_id")
  trainingPlan   TrainingPlan?  @relation(fields: [trainingPlanId], references: [trainingPlanId])
  trainingPlanId Int?           @map("training_plan_id")
  weeks          TrainingWeek[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([trainingPlanId])
  @@map("cycle")
}
