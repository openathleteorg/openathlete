model Record {
  // primary key
  recordId Int @id @default(autoincrement()) @map("record_id")

  // fields
  distance      Float // in meters
  date          DateTime
  startDuration Int?       @map("start_duration") // in seconds
  endDuration   Int?       @map("end_duration") // in seconds
  type          RecordType
  value         Float // unit depends on type

  // relationships
  eventActivity   EventActivity? @relation(fields: [eventActivityId], references: [eventActivityId])
  eventActivityId Int?           @map("event_activity_id")
  athlete         Athlete        @relation(fields: [athleteId], references: [athleteId])
  athleteId       Int            @map("athlete_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("record")
}
