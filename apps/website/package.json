{
  "name": "@openathlete/website",
  "version": "1.0.0",
  "description": "OpenAthlete marketing website",
  "author": "Tristan Bouillot <tristan@tblt.fr>",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && next dev -p 3003",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && next build",
    "translate": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,scss,sass}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,sass}\"",
    "tsc:check": "tsc --noEmit"
  },
  "dependencies": {
    "@inlang/paraglide-js": "2.25.4",
    "@openathlete/shared": "workspace:*",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.577.0",
    "next": "^15.5.27",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@inlang/cli": "^3.3.8",
    "@next/eslint-plugin-next": "^15.5.27",
    "@openathlete/eslint-config": "workspace:*",
    "@openathlete/prettier-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.15.0",
    "postcss": "^8.5.28",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}