{
  "name": "@openathlete/website",
  "version": "1.0.0",
  "description": "OpenAthlete marketing website",
  "author": "Tristan Bouillot <tristan@tblt.fr>",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && next dev -p 3003",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,scss,sass}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,sass}\"",
    "tsc:check": "tsc --noEmit"
  },
  "dependencies": {
    "@inlang/paraglide-js": "2.0.12",
    "@tanstack/react-query": "^5.67.2",
    "axios": "^1.8.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.479.0",
    "next": "^15.1.6",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.12",
    "tailwindcss-animate": "^1.0.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@inlang/cli": "^3.0.0",
    "@openathlete/eslint-config": "workspace:*",
    "@openathlete/prettier-config": "workspace:*",
    "@tailwindcss/postcss": "^4.0.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "postcss": "^8.4.49",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1"
  }
}

