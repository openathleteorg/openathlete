{
  "name": "@openathlete/api",
  "version": "1.0.0",
  "description": "API for OpenAthlete",
  "author": "Tristan Bouillot <tristan@tblt.fr>",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "nest build",
    "start": "nest start -e \"node -r dotenv/config\"",
    "dev": "nest start -b swc --watch -e \"node -r dotenv/config\"",
    "start:debug": "nest start --debug --watch -e \"node -r dotenv/config\"",
    "start:prod": "node -r dotenv/config dist/main",
    "format:write": "prettier --write \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "tsc:check": "tsc --noEmit",
    "test": "jest",
    "test:integration": "jest --config jest.integration.json --runInBand",
    "test:agents": "node --test test/agents.test.cjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@casl/ability": "^6.8.1",
    "@casl/prisma": "^1.6.2",
    "@garmin/fitsdk": "21.217.0",
    "@mastra/core": "^1.74.0",
    "@nestjs/bull": "^11.0.5",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.7",
    "@openathlete/database": "workspace:*",
    "@openathlete/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "@sentry/nestjs": "^11.4.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@we-gold/gpxjs": "^1.2.0",
    "adm-zip": "^0.6.1",
    "argon2": "^0.45.1",
    "axios": "^1.20.0",
    "bull": "^4.16.5",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.6.1",
    "fast-xml-parser": "^5.11.2",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "ical-generator": "^8.1.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nestjs-zod": "^4.3.1",
    "openai": "^6.49.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "stripe": "~20.0.0",
    "xmldom-qsa": "^1.1.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@openathlete/eslint-config": "workspace:*",
    "@openathlete/prettier-config": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/adm-zip": "^0.5.8",
    "@types/bull": "^4.10.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
