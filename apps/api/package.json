{
  "name": "@openathlete/api",
  "version": "1.0.0",
  "description": "API for OpenAthlete",
  "author": "Tristan Bouillot <tristan@tblt.fr>",
  "license": "MPL-2.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start -e \"node -r dotenv/config\"",
    "dev": "nest start -b swc --watch -e \"node -r dotenv/config\"",
    "start:debug": "nest start --debug --watch -e \"node -r dotenv/config\"",
    "start:prod": "node -r dotenv/config dist/main",
    "format:write": "prettier --write \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "tsc:check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.47",
    "@casl/ability": "^6.7.3",
    "@casl/prisma": "^1.5.1",
    "@garmin/fitsdk": "21.178.0",
    "@getbrevo/brevo": "^2.2.0",
    "@mastra/core": "^0.21.1",
    "@mastra/loggers": "^0.10.16",
    "@mastra/memory": "^0.15.7",
    "@mastra/pg": "^0.17.4",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^8.0.7",
    "@nestjs/websockets": "^11.1.6",
    "@openathlete/database": "workspace:*",
    "@openathlete/shared": "workspace:*",
    "@prisma/client": "6.4.1",
    "@sentry/nestjs": "^8.55.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@sports-alliance/sports-lib": "^5.4.24",
    "@we-gold/gpxjs": "^1.1.0",
    "adm-zip": "^0.5.16",
    "argon2": "^0.41.1",
    "axios": "^1.8.2",
    "bull": "^4.16.5",
    "bullmq": "^5.63.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^5.3.2",
    "ical-generator": "^8.1.1",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "nestjs-zod": "^4.3.1",
    "openai": "^6.3.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "stripe": "^20.0.0",
    "xmldom-qsa": "^1.1.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@openathlete/eslint-config": "workspace:*",
    "@openathlete/prettier-config": "workspace:*",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.11.8",
    "@types/adm-zip": "^0.5.7",
    "@types/bull": "^4.10.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}