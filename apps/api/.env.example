# =============================================================================
# OpenAthlete API - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
#
# Documentation: https://github.com/tristanblt/openathlete/blob/main/CONTRIBUTING.md
# =============================================================================

# -----------------------------------------------------------------------------
# Application Core
# -----------------------------------------------------------------------------

# Application environment: 'development' | 'staging' | 'production'
ENV=development

# Node environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Server port (default: 3000)
PORT=3000

# Base URL of the application (used for generating links in emails, etc.)
# Example: http://localhost:5173 (dev) or https://app.openathlete.org (prod)
APP_URL=http://localhost:5173

# Public URL of this API, where AI agents connect to the MCP server
# ({API_PUBLIC_URL}/mcp) and sign in through OAuth. Default: {APP_URL}/api,
# the Docker Compose setup where the web app forwards /api to the API.
API_PUBLIC_URL=http://localhost:3000

# Single sign-on through an OpenID Connect provider (Authentik, Keycloak,
# Authelia...). Register {API_PUBLIC_URL}/auth/oidc/callback as redirect URI.
# The secret is empty for a public client. OIDC_NAME labels the button.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=

# Who can create an account: open, invite (only with an invitation from a
# coach or athlete) or closed. The first account of the instance is always
# allowed. Default: open
SIGNUP_MODE=open

# CORS allowed origins (comma-separated)
# For development, include: http://localhost:5173,capacitor://localhost
# For production, include your production domains
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost,https://localhost

# Which reverse proxies to trust for the client IP (used by rate limiting).
# Default: proxies on private networks (Docker, Traefik, Coolify). Set a hop
# count (e.g. 2) when another public proxy such as Cloudflare sits in front.
# TRUST_PROXY=loopback,linklocal,uniquelocal

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------

# JWT secret key for signing tokens (use a strong random string)
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# Pepper for password hashing (additional security layer)
# Generate with: openssl rand -base64 16
HASH_PEPPER=your-hash-pepper-change-this-in-production

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?schema=public
# The default matches the PostgreSQL service of docker-compose.dev.yml
# (docker compose -f docker-compose.dev.yml up -d)
DATABASE_URL=postgresql://openathlete:openathlete_dev_password@localhost:5433/openathlete?schema=public

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Redis connection URL (used for queues, caching, Socket.IO adapter)
# Format: redis://[:password@]host[:port][/database]
# Example: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Images in notes and messages (S3-compatible storage, Optional)
# -----------------------------------------------------------------------------

# A private bucket on Amazon S3 or any S3-compatible service (Cloudflare R2,
# MinIO, Scaleway, OVHcloud...). With the bucket and both keys set, users can
# add images to their notes and messages; empty, images are off.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The service's endpoint, e.g. https://<account>.r2.cloudflarestorage.com
# (empty: Amazon S3)
S3_ENDPOINT=
# Default: auto on R2, us-east-1 elsewhere
S3_REGION=
# true for services that need path-style URLs, such as MinIO
S3_FORCE_PATH_STYLE=

# -----------------------------------------------------------------------------
# Email (Resend, Brevo or SMTP, Optional)
# -----------------------------------------------------------------------------

# Resend API key, tried first: https://resend.com/api-keys
RESEND_API_KEY=
# Signing secret of the Resend webhook (POST /api/webhooks/resend), whsec_...
# Events to tick: email.complained, email.bounced, contact.updated
RESEND_WEBHOOK_SECRET=
# Resend segment of the people who agreed to receive news (empty: no sync)
RESEND_NEWS_SEGMENT_ID=

# Deprecated, use Resend: Brevo (formerly Sendinblue) API key for sending emails
# Get it from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key

# Email address to send emails from (must be verified in Brevo)
BREVO_FROM_EMAIL=noreply@yourdomain.com

# Or any SMTP server, used when RESEND_API_KEY and BREVO_API_KEY are empty. SMTP_PORT defaults to
# 465 with SMTP_SECURE=true (implicit TLS), else 587 with STARTTLS
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# Sender address for Resend, Brevo and SMTP (default: BREVO_FROM_EMAIL)
EMAIL_FROM=
# Sender name shown in inboxes (default: OpenAthlete)
EMAIL_FROM_NAME=
# Where replies go, when nobody reads the sender address (optional)
EMAIL_REPLY_TO=
# Name signing the emails written in person: onboarding tips, monthly recap,
# news. Setting it turns those emails on (empty: only account emails)
EMAIL_SIGNATURE=

# Receives an email for each new account (optional, empty: no notification)
SIGNUP_NOTIFICATION_EMAIL=

# -----------------------------------------------------------------------------
# Strava Integration (Optional)
# -----------------------------------------------------------------------------

# Strava OAuth credentials
# Create an app at: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret

# Strava OAuth redirect URI (must match your Strava app settings)
# Format: {APP_URL}/auth/callback/strava
STRAVA_REDIRECT_URI=http://localhost:5173/auth/callback/strava

# Strava webhook verification token (random string)
# Used to verify webhook requests from Strava
STRAVA_WEBHOOK_TOKEN=your-strava-webhook-token

# -----------------------------------------------------------------------------
# Garmin Integration (Optional)
# -----------------------------------------------------------------------------

# Garmin Connect IQ OAuth credentials
# Register at: https://developer.garmin.com/connect-iq/developer-tools/
# Self-hosted personal use only; off by default. Not for instances serving other people.
GARMIN_PERSONAL_API_ENABLED=false
GARMIN_CLIENT_ID=your-garmin-client-id
GARMIN_CLIENT_SECRET=your-garmin-client-secret

# Garmin OAuth redirect URI
# Format: {APP_URL}/auth/callback/garmin
GARMIN_REDIRECT_URI=http://localhost:5173/auth/callback/garmin

# -----------------------------------------------------------------------------
# Polar Integration (Optional)
# -----------------------------------------------------------------------------

# Polar OAuth credentials
# Register at: https://www.polar.com/accesslink
POLAR_CLIENT_ID=your-polar-client-id
POLAR_CLIENT_SECRET=your-polar-client-secret

# Polar OAuth redirect URI
# Format: {APP_URL}/auth/callback/polar
POLAR_REDIRECT_URI=http://localhost:5173/auth/callback/polar

# Polar webhook URL (where Polar will send webhook events)
# Format: {API_URL}/provider/polar/webhook
POLAR_WEBHOOK_URL=http://localhost:3000/provider/polar/webhook

# Polar webhook secret key. Optional: the API creates the webhook itself and
# keeps its key in Redis. Set this only for a webhook created by hand.
POLAR_WEBHOOK_SECRET_KEY=your-polar-webhook-secret-key

# -----------------------------------------------------------------------------
# Suunto Integration (Optional)
# -----------------------------------------------------------------------------

# Suunto OAuth credentials
# Register at: https://www.suunto.com/developer/
SUUNTO_CLIENT_ID=your-suunto-client-id
SUUNTO_CLIENT_SECRET=your-suunto-client-secret

# Suunto OAuth redirect URI
# Format: {APP_URL}/auth/callback/suunto
SUUNTO_REDIRECT_URI=http://localhost:5173/auth/callback/suunto

# Suunto subscription key (for API access)
SUUNTO_SUBSCRIPTION_KEY=your-suunto-subscription-key

# Notification secret set in the Suunto app settings, to verify webhooks
SUUNTO_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Coros Integration
# -----------------------------------------------------------------------------

# Coros needs no credentials: each connection registers its own OAuth client.
# Optional redirect URI, defaults to {APP_URL}/auth/callback/coros
COROS_REDIRECT_URI=http://localhost:5173/auth/callback/coros

# -----------------------------------------------------------------------------
# AI (optional)
# -----------------------------------------------------------------------------
# Users bring their own provider keys and models (Settings > AI). Keys below
# are the instance's ("hosted AI"): any provider's standard variable works
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY,
# MISTRAL_API_KEY, OPENROUTER_API_KEY...).
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Instance models, as provider/model. AI_MODEL_DEFAULT applies to every
# feature without its own variable.
# AI_MODEL_DEFAULT=openai/gpt-5.6-luna
# AI_MODEL_EVENT_GENERATION=
# AI_MODEL_EVENT_MODIFICATION=
# AI_MODEL_POST_ACTIVITY_FEEDBACK=
# AI_MODEL_FEEDBACK_EXTRACTION=
# AI_MODEL_TRIMP_ESTIMATION=
# AI_MODEL_ACTIVITY_SUMMARY=

# Who may use the instance keys: everyone, subscribers (paid plan with AI) or
# none. Default: subscribers when Stripe is configured, everyone otherwise.
# AI_HOSTED_ACCESS=

# With Stripe: the weekly allowance of each offer on the instance keys is a
# share (0 to 1) of its reference price, converted from euros at
# AI_EUR_TO_USD. Both are needed for hosted AI with Stripe; a missing or
# invalid value turns hosted AI off (logged at boot). Each offer may have its
# own share (AI_HOSTED_BUDGET_SHARE_SUPPORTER, _COACH, _COACH_PRO, _CLUB,
# _CLUB_PLUS, _COACH_SEAT). Users with their own key are not limited.
# AI_HOSTED_BUDGET_SHARE=
# AI_EUR_TO_USD=

# What each user may spend per month on the instance keys, in US dollars at
# the providers' prices, spread over the weeks. Used when no share is set.
# Unset: no limit without Stripe.
# AI_HOSTED_MONTHLY_BUDGET_USD=

# Let users add OpenAI-compatible endpoints by URL (Ollama, vLLM, LM Studio).
# The server calls these URLs: keep it off on public instances. Default: on
# without Stripe, off with Stripe.
# AI_ALLOW_CUSTOM_ENDPOINTS=

# -----------------------------------------------------------------------------
# AI Services
# -----------------------------------------------------------------------------

# Errors, logs and product analytics in PostHog (optional). Leave the token
# empty to send nothing, which is the default for self-hosted instances.
POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=https://eu.i.posthog.com

# Token OpenAI gives to verify the domain of the ChatGPT app, served at
# /.well-known/openai-apps-challenge. Only the hosted instance needs it.
OPENAI_APPS_CHALLENGE_TOKEN=

# -----------------------------------------------------------------------------
# Stripe (Optional - billing is disabled when STRIPE_SECRET_KEY is unset)
# Checkout uses automatic tax: the Stripe account needs Stripe Tax set up
# (origin address, tax registrations), or creating a session fails.
# -----------------------------------------------------------------------------

# Stripe secret key (for server-side operations)
# Get it from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe publishable key (for client-side operations)
# Get it from: https://dashboard.stripe.com/apikeys
# STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Stripe webhook secret (for verifying webhook events)
# Get it from: https://dashboard.stripe.com/webhooks
# STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# The API finds its prices by lookup key, created by
# scripts/stripe/setup-pricing-v2.ts. These older variables only stand in for
# the lowest Supporter tier when Stripe has no price for it. Without Stripe,
# nothing is sold and no limit applies.
# STRIPE_PRICE_SUPPORTER_MONTHLY=price_xxx
# STRIPE_PRICE_SUPPORTER_YEARLY=price_yyy

# Testing only: a Stripe API to call instead of api.stripe.com, such as
# stripe-mock in the E2E stack. Never set it in production.
# STRIPE_API_URL=http://localhost:12111

# Testing only: the day the Supporter feature registry (libs/shared
# features.ts) takes as today, to see an early access start or end. Without
# Stripe every feature is available and this changes nothing.
# FEATURES_CLOCK=2026-12-01

# -----------------------------------------------------------------------------
# App Store in-app purchases (Optional - hosted iOS app only)
# -----------------------------------------------------------------------------

# Apple ID of the iOS app, from App Store Connect > App Information. Enables
# Supporter subscriptions bought in the iOS app, verified against Apple's
# signatures. App Store Server Notifications go to /subscription/apple/notifications.
# APPLE_IAP_APP_ID=1234567890

# -----------------------------------------------------------------------------
# Weather (Optional)
# -----------------------------------------------------------------------------

# Activity weather comes from the public Open-Meteo (api.open-meteo.com and
# archive-api.open-meteo.com). Set this to use your own Open-Meteo or a proxy
# instead: it must serve both /v1/forecast and /v1/archive.
# OPEN_METEO_BASE_URL=http://open-meteo:8080

# -----------------------------------------------------------------------------
# Firebase (Optional)
# -----------------------------------------------------------------------------

# Firebase Functions URL (for push notifications)
# Format: https://your-region-your-project.cloudfunctions.net
FIREBASE_FUNCTIONS_URL=https://your-region-your-project.cloudfunctions.net

# Firebase Service Account JSON
FIREBASE_SERVICE_ACCOUNT_JSON='{}'

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Enable activity import from providers (true/false)
# Set to false to disable automatic activity imports
ENABLE_ACTIVITY_IMPORT=true

# Enable activity processing (GPX parsing, metrics calculation, etc.)
# Set to false to disable processing pipeline
ENABLE_ACTIVITY_PROCESSING=true

# Enable AI-powered training load estimation (requires OpenAI API key)
# Set to false to disable this feature
ENABLE_TRAINING_LOAD_ESTIMATION=true
