# =============================================================================
# OpenAthlete Web - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
#
# Note: Vite uses the VITE_ prefix for environment variables
# Documentation: https://github.com/tristanblt/openathlete/blob/main/CONTRIBUTING.md
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

# Base URL of the API server
# Development: http://localhost:3000
# Production: https://api.openathlete.org

# If not set, defaults to:
#   - http://localhost:3000 (web)
#   - https://api.openathlete.org (Capacitor/native)
VITE_API_BASE_URL=http://localhost:3000

# Showcase website URL
VITE_WEBSITE_URL=http://localhost:3003