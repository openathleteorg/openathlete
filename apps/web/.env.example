# =============================================================================
# OpenAthlete Web - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
#
# Note: Vite uses the VITE_ prefix for environment variables
# Documentation: https://github.com/tristanblt/openathlete/blob/main/CONTRIBUTING.md
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

# Base URL of the API server
# Development: http://localhost:3000
# Production: https://api.openathlete.org

# If not set, defaults to:
#   - http://localhost:3000 (web)
#   - https://api.openathlete.org (Capacitor/native)
VITE_API_BASE_URL=http://localhost:3000

# Showcase website URL
VITE_WEBSITE_URL=http://localhost:3003

# -----------------------------------------------------------------------------
# Error monitoring (optional)
# -----------------------------------------------------------------------------

# Sentry-compatible DSN (e.g. Better Stack). Leave empty to disable.
VITE_ERROR_MONITORING_DSN=

# -----------------------------------------------------------------------------
# Product analytics (optional, hosted instance only)
# -----------------------------------------------------------------------------

# Leave empty to send no analytics (the default for self-hosted instances).
# When any tracker below or VITE_ERROR_MONITORING_DSN is set, users are asked
# for consent first: analytics and session recordings start only if they accept.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=
# Contentsquare tag ID, e.g. the "xxxx" in t.contentsquare.net/uxa/xxxx.js
VITE_CONTENTSQUARE_TAG_ID=
