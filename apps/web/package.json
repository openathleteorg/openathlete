    "firebase": "^11.10.0",
    "framer-motion": "^12.43.0",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.479.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.435.8",
