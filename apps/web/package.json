{
  "name": "@openathlete/web",
  "version": "1.0.0",
  "description": "OpenAthlete web application",
  "author": "Tristan Bouillot <tristan@tblt.fr>",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,sass}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,scss,sass}\"",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --max-warnings 0",
    "tsc:check": "tsc --noEmit",
    "machine-translate": "inlang machine translate --project project.inlang",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:build": "CAPACITOR=true pnpm build && pnpm cap:sync",
    "cap:dev": "pnpm dev --host",
    "cap:dev:android": "pnpm cap:dev & pnpm cap:sync && pnpm cap:open:android",
    "cap:dev:ios": "pnpm cap:dev & pnpm cap:sync && pnpm cap:open:ios"
  },
